# Existing Flint backend settings
MONGO_URI=
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
GOOGLE_CLIENT_ID=

# Transactional email (SMTP)
# Gmail example: smtp.gmail.com / 587 / false
# For another provider, replace these values with that provider's SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional. If omitted, emails are sent from SMTP_USER.
SMTP_FROM=Flint <your-email@gmail.com>

# Cashfree sandbox (switch CASHFREE_ENV to production only after merchant approval)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Billing prices in INR. Change these values without touching payment code.
PRICE_PREPARE_AI_CHAT=49
PRICE_RESUME_AI_CHAT=49
PRICE_LINKEDIN_CHAT=29
PRICE_PREMIUM_YEAR=999
